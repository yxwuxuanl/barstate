<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>popover.refreshing_count</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>Refreshing (%#@items@)</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld item</string>
            <key>other</key>
            <string>%lld items</string>
        </dict>
    </dict>
    <key>refresh.success</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@items@ refreshed successfully</string>
        <key>items</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld monitor</string>
            <key>other</key>
            <string>%lld monitors</string>
        </dict>
    </dict>
</dict>
</plist>
